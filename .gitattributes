# Normalisation des fins de ligne
* text=auto

# ---------------------------------------------------------------
# Fichiers YAML d'Unity : du texte, et ça doit le rester.
# Sérialisation en mode « Force Text » côté projet, sinon ces
# fichiers deviennent binaires et toute fusion devient impossible.
# ---------------------------------------------------------------
*.unity            text eol=lf
*.prefab           text eol=lf
*.asset            text eol=lf
*.mat              text eol=lf
*.anim             text eol=lf
*.controller       text eol=lf
*.overrideController text eol=lf
*.physicMaterial   text eol=lf
*.physicsMaterial2D text eol=lf
*.meta             text eol=lf
*.shader           text eol=lf
*.shadergraph      text eol=lf
*.hlsl             text eol=lf
*.cginc            text eol=lf
*.cs               text eol=lf diff=csharp
*.uxml             text eol=lf
*.uss              text eol=lf
*.json             text eol=lf
*.inputactions     text eol=lf

# ---------------------------------------------------------------
# Binaires : aucune conversion, jamais de diff textuel
# ---------------------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.so   binary
*.aar  binary
*.a    binary
*.cubemap binary
